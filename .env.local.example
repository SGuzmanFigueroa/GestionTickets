NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER prefix with NEXT_PUBLIC_ — this key bypasses Row Level
# Security. Get it from Supabase: Settings > API Keys > service_role.
# Used only to let an admin delete a user's account from Admin -> Usuarios.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
